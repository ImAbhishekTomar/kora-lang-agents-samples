#!/usr/bin/env bash
# Run the numbered agents against the real configured model and report what broke.
#
# Every agent that reads standard input has a data/seed.txt, and every agent
# that calls ask_human has a data/answer.txt, so the whole suite runs without a
# person at the keyboard and the same inputs are used every time.
#
# Usage:
#   scripts/live-run                 # all 100
#   scripts/live-run 017 042         # only these (prefix match on folder name)
#   scripts/live-run --from 050      # resume the suite at agent 050
#   scripts/live-run --record        # also save cassettes for later --replay
#   scripts/live-run --replay        # use recorded cassettes; reach no provider
#
# Logs land in logs/live/<timestamp>/, which git ignores.
set -uo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
kora_bin="${KORA_BIN:-$repo_root/../kora-lang/target/debug/kora}"
run_flags=()
only=()
from=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --record|--replay|--trace) run_flags+=("$1"); shift ;;
    --from) from="$2"; shift 2 ;;
    --help|-h) sed -n '2,16p' "$0"; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) only+=("$1"); shift ;;
  esac
done

if [[ ! -x "$kora_bin" ]]; then
  echo "Kora compiler not found at $kora_bin" >&2
  echo "Build it, or set KORA_BIN to the compiler you want to use." >&2
  exit 1
fi

if [[ -f "$repo_root/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$repo_root/.env"
  set +a
fi

# --replay never reaches a provider, so it needs no credential.
if [[ ! " ${run_flags[*]-} " =~ " --replay " && -z "${OPENAI_API_KEY:-}" ]]; then
  echo "OPENAI_API_KEY is not set. Add it to the ignored .env file or export it." >&2
  echo "The 100 numbered agents all use the 'gpt' model role, which reads that variable." >&2
  exit 1
fi

cd "$repo_root"
stamp="$(date +%Y%m%d-%H%M%S)"
log_dir="logs/live/$stamp"
mkdir -p "$log_dir"

agents=()
while IFS= read -r dir; do
  name="$(basename "$dir")"
  [[ "$name" == 000-* ]] && continue          # the original vision sample, not numbered suite
  [[ -n "$from" && "$name" < "$from" ]] && continue
  if [[ ${#only[@]} -gt 0 ]]; then
    keep=""
    for want in "${only[@]}"; do
      [[ "$name" == "$want"* ]] && keep=1
    done
    [[ -z "$keep" ]] && continue
  fi
  agents+=("$name")
done < <(find agents -mindepth 1 -maxdepth 1 -type d | sort)

if [[ ${#agents[@]} -eq 0 ]]; then
  echo "no agents matched" >&2
  exit 1
fi

# One suspended durable run answered from the agent's canned answer. Returns
# non-zero if the run never suspended or never reached completed.
resume_durable() {
  local program="$1" answer="$2" log="$3"
  local id
  id="$("$kora_bin" runs "$program" 2>/dev/null | awk '$2 == "suspended" { print $1; exit }')"
  if [[ -z "$id" ]]; then
    echo "expected a suspended run, found none" >> "$log"
    return 1
  fi
  echo "--- answering run $id ---" >> "$log"
  "$kora_bin" answer "$program" "$id" "$answer" >> "$log" 2>&1
  "$kora_bin" runs "$program" 2>/dev/null | grep -q "^  $id  completed" && return 0
  echo "run $id did not reach completed" >> "$log"
  return 1
}

passed=(); failed=()
total=${#agents[@]}
index=0

for name in "${agents[@]}"; do
  index=$((index + 1))
  program="agents/$name/main.ko"
  log="$log_dir/$name.log"
  seed="agents/$name/data/seed.txt"
  answer_file="agents/$name/data/answer.txt"
  printf '[%3d/%3d] %-34s ' "$index" "$total" "$name"

  stdin_source="/dev/null"
  [[ -f "$seed" ]] && stdin_source="$seed"

  ok=0
  if [[ -f "$answer_file" ]]; then
    # ask_human suspends the run; journal it so the answer can resume it.
    "$kora_bin" run --durable --report "${run_flags[@]-}" "$program" \
      < "$stdin_source" > "$log" 2>&1
    resume_durable "$program" "$(cat "$answer_file")" "$log" || ok=1
  else
    "$kora_bin" run --report "${run_flags[@]-}" "$program" \
      < "$stdin_source" > "$log" 2>&1 || ok=1
  fi

  # A Kora program reports recoverable outcomes as values, so a zero exit is
  # not proof. Treat a runtime error line in the output as a failure too.
  if grep -qiE '^(error|panic)|runtime error|provider error' "$log"; then
    ok=1
  fi

  if [[ $ok -eq 0 ]]; then
    echo "ok"
    passed+=("$name")
  else
    echo "FAILED"
    failed+=("$name")
  fi
done

echo
echo "passed: ${#passed[@]}/$total"
if [[ ${#failed[@]} -gt 0 ]]; then
  echo "failed: ${#failed[@]}"
  for name in "${failed[@]}"; do
    echo "  $name  ->  $log_dir/$name.log"
  done
  exit 1
fi
echo "logs: $log_dir"
