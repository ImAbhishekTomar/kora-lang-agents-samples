use fs
use json

type Review:
    summary: str @description("Factual, concise result")
    decision: str @description("approve, review, reject, or escalate")
    evidence: list[str] @description("Short source-grounded evidence items")

TASK = "rubric scores with cited evidence. Use only the supplied source, cite evidence, and say what is missing."

tool measure_source(text: str) -> int:
    "Return the source length so the model can detect empty evidence."
    return len(text)

agent investigate(source: str) -> str:
    budget: max_tokens = 2_000, max_calls = 2, max_steps = 4

    result: Review = analyze(source, TASK, model="gpt", tools=[measure_source])
    match result:
        case Ok(review):
            return f"{review.decision}: {review.summary}"
        case Uncertain(reason):
            return f"uncertain: {reason}"
        case Exhausted(meter):
            return f"exhausted: {meter}"
        case Failed(reason):
            return f"failed: {reason}"

def load_input() -> str:
    combined = ""
    match fs.read("agents/036-vendor-proposal-scorer/data/rubric.json"):
        case Ok(text):
            combined = combined + "\n" + text
        case Err(why):
            combined = combined + f"\nread error: {why}"
    match fs.read("agents/036-vendor-proposal-scorer/data/proposals/alpha.md"):
        case Ok(text):
            combined = combined + "\n" + text
        case Err(why):
            combined = combined + f"\nread error: {why}"
    match fs.read("agents/036-vendor-proposal-scorer/data/proposals/beta.md"):
        case Ok(text):
            combined = combined + "\n" + text
        case Err(why):
            combined = combined + f"\nread error: {why}"
    return combined

def main():
    source = load_input()
    output = investigate(source)
    with budget(max_tokens = 6_000):
        outputs = parallel for item in [source]:
            return investigate(item)
    for output in outputs:
        print(output)

test "mocked model result is rendered deterministically":
    with mock analyze -> Ok(Review("fixture-backed result", "review", ["synthetic source"])):
        output = investigate("synthetic input")
        assert output == "review: fixture-backed result", f"got: {output}"

test "all non-success outcomes remain values":
    with mock analyze -> Uncertain("needs evidence"):
        assert investigate("x") == "uncertain: needs evidence"
    with mock analyze -> Exhausted("tokens"):
        assert investigate("x") == "exhausted: tokens"
    with mock analyze -> Failed("provider unavailable"):
        assert investigate("x") == "failed: provider unavailable"

