use fs
use json
use time

type Review:
    summary: str @description("Factual, concise result")
    decision: str @description("approve, review, reject, or escalate")
    evidence: list[str] @description("Short source-grounded evidence items")

TASK = "turns notes and alerts into an urgent, owned handoff. Use only the supplied source, cite evidence, and say what is missing."

agent investigate(source: str) -> str:
    budget: max_tokens = 2_000, max_calls = 2, max_steps = 4

    result: Review = analyze(source, TASK, model="gpt")
    match result:
        case Ok(review):
            return f"{review.decision}: {review.summary}"
        case Uncertain(reason):
            return f"uncertain: {reason}"
        case Exhausted(meter):
            return f"exhausted: {meter}"
        case Failed(reason):
            return f"failed: {reason}"

def load_input() -> str:
    combined = ""
    match fs.read("agents/040-shift-handoff/data/shift_notes.md"):
        case Ok(text):
            combined = combined + "\n" + text
        case Err(why):
            combined = combined + f"\nread error: {why}"
    match fs.read("agents/040-shift-handoff/data/alerts.json"):
        case Ok(text):
            combined = combined + "\n" + text
        case Err(why):
            combined = combined + f"\nread error: {why}"
    return combined

def main():
    source = load_input()
    output = investigate(source)
    if fs.exists("agents/040-shift-handoff/data"):
        match fs.list("agents/040-shift-handoff/data"):
            case Ok(paths):
                print(f"handoff used {len(paths)} source files")
            case Err(why):
                print(f"could not list handoff data: {why}")
    match fs.write("agents/040-shift-handoff/handoff-output.md", output + "\n"):
        case Ok(_):
            print("wrote agents/040-shift-handoff/handoff-output.md")
        case Err(why):
            print(f"could not write handoff: {why}")
    match time.format(time.now(), "iso"):
        case Ok(generated_at):
            match fs.append("agents/040-shift-handoff/handoff-output.md", f"generated: {generated_at}\n"):
                case Ok(_):
                    pass
                case Err(why):
                    print(f"could not append timestamp: {why}")
        case Err(why):
            print(f"could not format timestamp: {why}")
    print(output)

test "mocked model result is rendered deterministically":
    with mock analyze -> Ok(Review("fixture-backed result", "review", ["synthetic source"])):
        output = investigate("synthetic input")
        assert output == "review: fixture-backed result", f"got: {output}"

test "all non-success outcomes remain values":
    with mock analyze -> Uncertain("needs evidence"):
        assert investigate("x") == "uncertain: needs evidence"
    with mock analyze -> Exhausted("tokens"):
        assert investigate("x") == "exhausted: tokens"
    with mock analyze -> Failed("provider unavailable"):
        assert investigate("x") == "failed: provider unavailable"
