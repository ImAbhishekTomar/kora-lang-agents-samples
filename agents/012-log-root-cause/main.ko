use fs
use json
use re

type Finding:
    likely_cause: str
    evidence: list[str]
    checks: list[str]

tool error_lines(log_text: str) -> list[str]:
    "Return lines containing an ERROR marker."
    match re.find_all("ERROR[^\\n]*", log_text):
        case Ok(lines):
            return lines
        case Err(_):
            return []

tool deploy_version(deploy_text: str) -> str:
    "Return the deployed version when present."
    match json.parse(deploy_text):
        case Ok(deploy):
            if "version" in deploy:
                return deploy["version"]
        case Err(_):
            pass
    return "unknown"

agent investigate(facts: dict) -> str:
    budget: max_tokens = 4800, max_calls = 3, max_steps = 6
    with context(max_input_tokens = 9000, reserve_output_tokens = 1200):
        result: Finding = analyze(facts, "Correlate log evidence with deployment facts. Use tools for exact extraction. Separate likely cause from validation checks.", model="gpt", tools=[error_lines, deploy_version])
    match result:
        case Ok(finding):
            return f"CAUSE {finding.likely_cause}\nEVIDENCE {finding.evidence}\nCHECKS {finding.checks}"
        case Uncertain(reason):
            return f"ROOT CAUSE UNCERTAIN: {reason}"
        case Exhausted(meter):
            return f"INVESTIGATION EXHAUSTED: {meter}"
        case Failed(why):
            return f"INVESTIGATION FAILED: {why}"

def main():
    match fs.read("agents/012-log-root-cause/data/app.log"):
        case Ok(log_text):
            match fs.read("agents/012-log-root-cause/data/deploy.json"):
                case Ok(deploy_text):
                    match json.parse(deploy_text):
                        case Ok(deploy):
                            print(investigate({"log": log_text, "deploy": deploy_text}))
                        case Err(why):
                            print(f"Invalid deploy JSON: {why}")
                case Err(why):
                    print(f"Could not read deploy data: {why}")
        case Err(why):
            print(f"Could not read log: {why}")

test "root cause returns evidence":
    finding = Finding("schema mismatch after deploy", ["first error follows v2.4.0"], ["compare migrations"])
    with mock analyze -> Ok(finding):
        assert "schema mismatch" in investigate({"log": "ERROR column missing", "deploy": "{\"version\":\"v2.4.0\"}"})
